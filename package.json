{
  "name": "toolceo",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "node start.js",
    "prebuild": "node scripts/prebuild.js",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.nythris.toolceo",
    "productName": "ToolCEO",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ToolCEO"
    },
    "extraResources": [
      {
        "from": "engines/",
        "to": "engines/",
        "filter": [
          "**/*",
          "!libreoffice/**",
          "!calibre/**",
          "!tesseract/**",
          "!pandoc/**",
          "!ffmpeg/**",
          "!7zip/**",
          "!ocr/**",
          "!document/**",
          "!ebook/**",
          "!media/**",
          "!*.zip"
        ]
      },
      {
        "from": "modules.json",
        "to": "../modules.json"
      },
      {
        "from": "build-info.json",
        "to": "../build-info.json"
      }
    ],
    "files": [
      "frontend/**/*",
      "electron/**/*",
      "assets/**/*",
      "resources/**/*",
      "build-info.json",
      "package.json"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.0.0",
    "jimp": "^1.6.1"
  }
}
