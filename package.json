{
  "name": "toolceo",
  "version": "1.0.0",
  "description": "ToolCEO Desktop Application",
  "author": "ToolCEO Team",
  "main": "electron/main.js",
  "scripts": {
    "start": "node start.js",
    "prebuild": "node scripts/prebuild.js",
    "build": "node scripts/build.js --win --x64",
    "build:store": "electron-builder --win appx",
    "predist": "node scripts/prebuild.js",
    "dist": "node scripts/build.js --win --x64"
  },
  "build": {
    "appId": "com.nythris.toolceo",
    "productName": "ToolCEO",
    "npmRebuild": false,
    "compression": "normal",
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ToolCEO"
    },
    "appx": {
      "applicationId": "ToolCEO",
      "identityName": "NomanRafique.ToolCEO",
      "publisher": "CN=E0E92099-0173-4976-BD98-C12569B9D850",
      "publisherDisplayName": "Noman Rafique",
      "backgroundColor": "#1a2e2a"
    },
    "extraResources": [
      {
        "from": "engines/",
        "to": "engines/",
        "filter": [
          "python/**",
          "rar/**"
        ]
      },
      {
        "from": "modules.json",
        "to": "../modules.json"
      },
      {
        "from": "build-info.json",
        "to": "../build-info.json"
      }
    ],
    "files": [
      "frontend/**/*",
      "electron/**/*",
      "assets/**/*",
      "resources/**/*",
      "build-info.json",
      "package.json"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.0.0",
    "jimp": "^1.6.1"
  }
}
